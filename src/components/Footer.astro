---
import { Icon } from "astro-icon/components";
const { name } = Astro.props;
---
<footer>
  <div class="container inner">
    <p class="copy">© 2026 {name}</p>
    <a class="top" href="#accueil">
      <span class="top__label">Retour en haut</span>
      <span class="top__icon" aria-hidden="true"><Icon name="lucide:arrow-up" size={18} /></span>
    </a>
  </div>
</footer>

<style>
  footer { padding: 2.25rem 0 2.5rem; }
  .inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .copy { font-size: 0.9rem; color: var(--color-text-muted); }

  .top {
    display: inline-flex; align-items: center; gap: 0.85rem; padding: 0.4rem 0.4rem 0.4rem 1.25rem;
    border: 1px solid var(--color-border); border-radius: 999px; background: var(--color-surface);
    color: var(--color-heading); text-decoration: none; font-weight: 600; font-size: 0.92rem;
    transition: border-color 0.25s, background 0.25s, color 0.25s, box-shadow 0.25s;
  }
  .top__icon {
    position: relative; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; overflow: hidden;
    border-radius: 50%; background: var(--color-accent); color: var(--color-on-accent); transition: background 0.25s;
  }
  .top__icon :global(svg) { transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
  .top:hover { border-color: var(--color-accent); background: var(--color-tint); color: var(--color-accent-hover); box-shadow: 0 10px 24px -14px color-mix(in srgb, var(--color-accent) 60%, transparent); }
  .top:hover .top__icon { background: var(--color-accent-hover); }
  .top:hover .top__icon :global(svg) { animation: rise 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes rise { 0% { transform: translateY(0); } 45% { transform: translateY(-140%); } 46% { transform: translateY(140%); } 100% { transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .top:hover .top__icon :global(svg) { animation: none; } }
</style>
