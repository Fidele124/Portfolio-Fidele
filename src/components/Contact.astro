---
import { Icon } from "astro-icon/components";
const email = "fidelelokossou38@gmail.com";
// URL d'un service de formulaire (Formspree, Web3Forms, etc.). Sans elle, le formulaire ouvre la messagerie de l'utilisateur.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "";
// Téléphone (+241 62 30 71 00) : à confirmer avant publication, volontairement absent.
---
<section class="contact" id="contact" aria-labelledby="contact-titre">
 <div class="panel">
  <div class="aurora" aria-hidden="true"><span class="blob blob--a"></span><span class="blob blob--b"></span><span class="blob blob--c"></span></div>
  <div class="mesh" aria-hidden="true"></div>

  <div class="container grid">
    <div class="intro reveal">
      <p class="eyebrow">04 · Contact</p>
      <h2 class="title" id="contact-titre">Un projet, une question, une opportunité ?</h2>
      <p class="lead">Écrivez-moi avec le formulaire ou directement par e-mail, je vous réponds dès que possible.</p>

      <ul class="channels">
        <li class="channel">
          <span class="channel__icon"><Icon name="lucide:mail" size={20} aria-hidden="true" /></span>
          <a class="channel__main" href={`mailto:${email}`}><small>E-mail</small><span class="mono">{email}</span></a>
          <button class="copy" type="button" data-copy={email} aria-label="Copier l'adresse e-mail"><Icon name="lucide:copy" size={18} aria-hidden="true" /></button>
        </li>
        <li class="channel">
          <span class="channel__icon"><Icon name="lucide:linkedin" size={20} aria-hidden="true" /></span>
          <a class="channel__main" href="https://www.linkedin.com/in/fidelelokossou" target="_blank" rel="noopener noreferrer">
            <small>LinkedIn</small><span class="mono">@fidelelokossou</span><span class="sr-only">(s'ouvre dans un nouvel onglet)</span>
          </a>
          <Icon class="go" name="lucide:arrow-up-right" size={18} aria-hidden="true" />
        </li>
        <li class="channel">
          <span class="channel__icon"><Icon name="lucide:github" size={20} aria-hidden="true" /></span>
          <a class="channel__main" href="https://github.com/Fidele124" target="_blank" rel="noopener noreferrer">
            <small>GitHub</small><span class="mono">@Fidele124</span><span class="sr-only">(s'ouvre dans un nouvel onglet)</span>
          </a>
          <Icon class="go" name="lucide:arrow-up-right" size={18} aria-hidden="true" />
        </li>
      </ul>
      <p class="copy-status" role="status" aria-live="polite"></p>
    </div>

    <form class="form reveal" style="--d:0.1s" data-form data-endpoint={endpoint} data-email={email} method="post" novalidate>
      <h3 class="form__title">Envoyer un message</h3>

      <div class="field">
        <label for="c-nom">Nom</label>
        <input id="c-nom" name="nom" type="text" autocomplete="name" required placeholder="Votre nom" />
        <p class="error" id="c-nom-err" hidden>Merci d'indiquer votre nom.</p>
      </div>
      <div class="field">
        <label for="c-email">Adresse e-mail</label>
        <input id="c-email" name="email" type="email" autocomplete="email" required placeholder="vous@exemple.com" />
        <p class="error" id="c-email-err" hidden>Merci d'indiquer une adresse e-mail valide.</p>
      </div>
      <div class="field">
        <label for="c-message">Message</label>
        <textarea id="c-message" name="message" rows="5" required placeholder="Décrivez votre projet ou votre question"></textarea>
        <p class="error" id="c-message-err" hidden>Merci d'écrire votre message.</p>
      </div>

      <!-- Champ piège anti-spam : doit rester vide -->
      <div class="hp" aria-hidden="true"><label>Ne pas remplir <input name="website" type="text" tabindex="-1" autocomplete="off" /></label></div>

      <button class="btn btn--primary submit" type="submit"><Icon name="lucide:send" size={18} aria-hidden="true" /> Envoyer le message</button>
      <p class="form__status" role="status" aria-live="polite"></p>
    </form>
  </div>
 </div>
</section>

<script>
  // Copier l'adresse
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy]");
  const copyStatus = document.querySelector<HTMLElement>(".copy-status");
  copyBtn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.copy!);
      copyStatus!.textContent = "Adresse copiée.";
    } catch {
      copyStatus!.textContent = "Copie impossible, sélectionnez l'adresse.";
    }
  });

  // Formulaire : envoi vers le service configuré, sinon ouverture de la messagerie
  const form = document.querySelector<HTMLFormElement>("[data-form]");
  if (form) {
    const status = form.querySelector<HTMLElement>(".form__status")!;
    const submit = form.querySelector<HTMLButtonElement>(".submit")!;
    const fields = ["nom", "email", "message"] as const;

    const validate = () => {
      let firstInvalid: HTMLElement | null = null;
      fields.forEach((name) => {
        const input = form.elements.namedItem(name) as HTMLInputElement;
        const err = form.querySelector<HTMLElement>(`#c-${name}-err`)!;
        const ok = input.value.trim() !== "" && input.checkValidity();
        err.hidden = ok;
        input.setAttribute("aria-invalid", String(!ok));
        if (input.getAttribute("aria-describedby") !== err.id) input.setAttribute("aria-describedby", err.id);
        if (!ok && !firstInvalid) firstInvalid = input;
      });
      firstInvalid?.focus();
      return !firstInvalid;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      status.textContent = "";
      status.dataset.state = "";
      if (!validate()) return;
      const data = new FormData(form);
      if (data.get("website")) return; // robot

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        const subject = `Message de ${data.get("nom")} depuis le portfolio`;
        const body = `${data.get("message")}\n\n${data.get("nom")}\n${data.get("email")}`;
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        status.textContent = "Votre messagerie va s'ouvrir avec le message prêt à envoyer.";
        return;
      }

      submit.disabled = true;
      status.textContent = "Envoi en cours…";
      try {
        const res = await fetch(endpoint, { method: "POST", body: data, headers: { Accept: "application/json" } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.dataset.state = "ok";
        status.textContent = "Merci, votre message a bien été envoyé.";
      } catch {
        status.dataset.state = "error";
        status.textContent = `L'envoi a échoué. Vous pouvez écrire directement à ${form.dataset.email}.`;
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  .contact { padding: 0 0.75rem 0.75rem; }
  .panel {
    position: relative; isolation: isolate; overflow: clip; border-radius: 2rem; padding: 4.5rem 0;
    color: var(--color-on-inverse);
    background: linear-gradient(155deg, var(--color-inverse-bg) 0%, var(--color-deep) 100%);
  }

  /* Aurore : trois halos flous qui dérivent lentement */
  .aurora { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .blob { position: absolute; border-radius: 50%; filter: blur(80px); will-change: transform; }
  .blob--a { width: 34rem; height: 34rem; top: -12rem; right: -8rem; background: var(--color-aurora-1); animation: drift-a 20s ease-in-out infinite alternate; }
  .blob--b { width: 28rem; height: 28rem; bottom: -12rem; left: -8rem; background: var(--color-aurora-1); opacity: 0.8; animation: drift-b 24s ease-in-out infinite alternate; }
  .blob--c { width: 18rem; height: 18rem; top: 30%; left: 42%; background: var(--color-aurora-2); opacity: 0.28; animation: drift-c 28s ease-in-out infinite alternate; }
  @keyframes drift-a { to { transform: translate(-6rem, 5rem) scale(1.15); } }
  @keyframes drift-b { to { transform: translate(7rem, -4rem) scale(1.2); } }
  @keyframes drift-c { to { transform: translate(-5rem, 4rem) scale(0.8); } }

  /* Quadrillage fin, estompé sur les bords */
  .mesh {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image: linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 3.25rem 3.25rem;
    mask-image: radial-gradient(75% 85% at 50% 40%, #000, transparent);
  }

  .grid { position: relative; display: grid; gap: 3rem; align-items: start; }
  .eyebrow { color: var(--color-focus-inverse); }
  .title { font-size: clamp(2.2rem, 5.5vw, 3.6rem); max-width: 14ch; color: var(--color-on-inverse); }
  .lead { margin-top: 1.25rem; color: var(--color-on-inverse-muted); font-size: 1.1rem; max-width: 30rem; }

  .channels { display: grid; gap: 0.75rem; margin-top: 2.25rem; max-width: 28rem; }
  .channel { display: flex; align-items: center; gap: 0.9rem; padding: 0.75rem 1rem; background: var(--color-glass); border: 1px solid var(--color-glass-border); border-radius: 16px; backdrop-filter: blur(14px); transition: border-color 0.2s, background 0.2s; }
  .channel:hover { border-color: var(--color-on-inverse-muted); background: rgb(255 255 255 / 0.11); }
  .channel__icon { display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: rgb(255 255 255 / 0.12); color: var(--color-on-inverse); }
  .channel__main { flex: 1; min-width: 0; display: grid; text-decoration: none; color: var(--color-on-inverse); font-weight: 600; }
  .channel__main:hover { color: var(--color-on-inverse); }
  .channel__main small { font-weight: 400; font-size: 0.78rem; color: var(--color-on-inverse-muted); }
  .channel__main .mono { font-size: 0.7rem; overflow-wrap: anywhere; }
  .channel :global(.go) { color: var(--color-on-inverse-muted); flex: none; }
  .copy { display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; border: 0; border-radius: 50%; background: rgb(255 255 255 / 0.12); color: var(--color-on-inverse); cursor: pointer; transition: background 0.2s, color 0.2s; }
  .copy:hover { background: var(--color-on-inverse); color: var(--color-ink); }
  .copy-status { min-height: 1.5em; margin-top: 0.5rem; font-size: 0.88rem; color: var(--color-on-inverse); }

  /* Formulaire en verre dépoli */
  .form { display: grid; gap: 1.1rem; padding: 1.5rem; background: var(--color-glass); border: 1px solid var(--color-glass-border); border-radius: var(--radius-lg); backdrop-filter: blur(22px) saturate(1.2); box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.5), inset 0 1px 0 rgb(255 255 255 / 0.12); }
  .form__title { font-size: 1.35rem; letter-spacing: -0.02em; color: var(--color-on-inverse); }
  .field { display: grid; gap: 0.4rem; }
  label { font-size: 0.9rem; font-weight: 500; color: var(--color-on-inverse); }
  input, textarea {
    width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--color-glass-border); border-radius: 12px; background: rgb(255 255 255 / 0.06);
    font: inherit; color: var(--color-on-inverse); transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }
  input::placeholder, textarea::placeholder { color: var(--color-on-inverse-muted); opacity: 0.75; }
  input:hover, textarea:hover { border-color: var(--color-on-inverse-muted); }
  input:focus-visible, textarea:focus-visible { outline: none; background: rgb(255 255 255 / 0.1); border-color: var(--color-focus-inverse); box-shadow: 0 0 0 3px rgb(147 197 253 / 0.3); }
  input[aria-invalid="true"], textarea[aria-invalid="true"] { border-color: var(--color-on-inverse); }
  textarea { resize: vertical; min-height: 8rem; }
  .error { font-size: 0.85rem; color: var(--color-on-inverse); font-weight: 600; }
  .error::before { content: "! "; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .submit { width: 100%; background: var(--color-on-inverse); border-color: var(--color-on-inverse); color: var(--color-ink); }
  .submit:hover { background: #dbeafe; border-color: #dbeafe; color: var(--color-ink); }
  .submit:disabled { opacity: 0.6; cursor: progress; }
  .form__status { min-height: 1.5em; font-size: 0.9rem; color: var(--color-on-inverse-muted); }
  .form__status[data-state] { color: var(--color-on-inverse); font-weight: 500; }
  .panel :focus-visible { outline-color: var(--color-focus-inverse); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (min-width: 30rem) { .channel__main .mono { font-size: 0.82rem; } }
  @media (min-width: 40rem) { .channel__main .mono { font-size: 0.88rem; } }
  @media (min-width: 52rem) {
    .contact { padding: 0 1.25rem 1.25rem; }
    .panel { border-radius: 2.5rem; padding: 7rem 0; }
    .grid { grid-template-columns: 1fr 1.05fr; gap: 5rem; }
    .form { padding: 2.25rem; }
  }
  @media (prefers-reduced-motion: reduce) { .blob { animation: none; } }
</style>
